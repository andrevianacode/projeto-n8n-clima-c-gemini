    {
      "parameters": {
        "jsCode": "const body = $json.body ?? {};\nconst city = body.name ?? 'cidade';\nconst tempRaw = body.main?.temp;\nconst temp = Number.isFinite(Number(tempRaw)) ? Math.round(Number(tempRaw)) : null;\nconst fallback_message = temp === null\n  ? '❌ Cidade não encontrada. Use o formato Cidade,UF,BR (ex.: São Paulo,SP,BR).'\n  : `🌤️ A temperatura em ${city} é de ${temp}°C.`;\nreturn [{json:{\n  city,\n  temp,\n  fallback_message,\n  usar_gemini:false,\n  gemini_prompt:`Responda SOMENTE em JSON válido, sem markdown, no formato {\"message\":\"...\",\"ok\":true}. Escreva em português do Brasil, de forma curta, natural e amigável. Não invente informação e não altere a temperatura. Cidade: ${city}. Temperatura atual: ${temp}°C. Preserve o mesmo sentido de: \"${fallback_message}\".`\n}}];"
      },
