    {
      "parameters": {
        "jsCode": "const fallback = $('Fallback Deterministico').item.json.fallback_message;\ntry {\n  let raw = $json?.content?.parts?.[0]?.text ?? $json?.candidates?.[0]?.content?.parts?.[0]?.text ?? $json?.text ?? $json?.message ?? '';\n  if (typeof raw === 'object' && raw?.message) return [{json:{message:String(raw.message).trim(),ok:true,source:'gemini'}}];\n  raw = String(raw).trim().replace(/^```json\\s*/i,'').replace(/```$/,'').trim();\n  const obj = JSON.parse(raw);\n  if (obj && typeof obj.message === 'string' && obj.message.trim()) return [{json:{message:obj.message.trim(),ok:obj.ok!==false,source:'gemini'}}];\n} catch(e) {}\nreturn [{json:{message:fallback,ok:true,source:'fallback'}}];"
      },
